{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "mise exec bun -- bun \"$CLAUDE_PROJECT_DIR/hooks/check-line-length.ts\" --extensions md,ts,tsx,js,jsx,mjs,cjs --suppressions \"oxlint-disable|@ts-expect-error\""
          }
        ]
      }
    ]
  }
}
